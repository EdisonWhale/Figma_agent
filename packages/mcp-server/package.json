{
  "name": "figma-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for Figma FigJam sticky note creation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "figma-mcp-server": "./dist/index.js"
  },
  "scripts": {
